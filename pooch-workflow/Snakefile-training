rule step01_Make_Pooch_Inputs:
    input:
        fofn            =   FOFN,
        sex             =   SEX,
    output:
        diffMethyl      =   f"{OUTDIR}/training/{{chroms}}.missing_rate_{MISSINGRATE}.createDiffDatasetFromMethylDataset.out"

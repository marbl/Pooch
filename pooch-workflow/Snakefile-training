            --log-file {params.mainDir}/training/{wildcards.chroms}.createMethylDataset.log

        echo "Filtering methyl dataset for {wildcards.chroms} with missing rate {params.missingrate}"
        cd {params.mainDir}/training/
        python {params.script}/10.filterMissingRate.py {wildcards.chroms} {params.missingrate}

        echo "Creating differential methylation dataset for {params.sample} on chromosome {wildcards.chroms}"
        python {params.pofo}/createDiffDatasetFromMethylDataset.py \
            --input-methyl-dataset {wildcards.chroms}.missing_rate_{params.missingrate}.createMethylDataset.out \
            -L Maternal -R Paternal \
            -c {wildcards.chroms} \
            -l {wildcards.chroms}.missing_rate_{params.missingrate}.createDiffDatasetFromMethylDataset.log \
            --output-file {wildcards.chroms}.missing_rate_{params.missingrate}.createDiffDatasetFromMethylDataset.out
        """



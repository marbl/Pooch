        diffMethyl_log  =   f"{OUTDIR}/training/{{chroms}}.makeInputs.log"
    params:
        sample          =   OUTPUT_PREFIX,
        mainDir         =   OUTDIR,
        pofo            =   f"{POFO_TOOLS_DIR}/src/pofo_tools/",
        script          =   f"{SCRIPTS_DIR}",
        chroms          =   lambda wc: wc.chroms,
        missingrate      =   MISSINGRATE,
    resources:
        mem_mb          =   lambda wildcards, attempt: attempt * 10000
    threads: THREADS
    shell: 
        """
        exec > >(tee -a {log}) 2>&1

### Step 3 : Cleaning Output


rule step03_cleaning_output:
    input:
        stat        =   expand(f"{OUTDIR}/training/elasticnet_selected_cpgs_{{chroms}}.csv", chroms=CHROMS),
    output:
        statConcat  =   f"{OUTDIR}/training/{OUTPUT_PREFIX}.training.out"
    params:
        sample      =   OUTPUT_PREFIX,
        mainDir     =   OUTDIR
    resources:
        mem_mb      = lambda wildcards, attempt: attempt * 10000
    threads: THREADS 
    run: 

        import os

        output_lines = []
        sample = params.sample
        outdir = params.mainDir

        for filepath in input.stat:
            
            filename = os.path.basename(filepath)
            chrom = filename.replace("elasticnet_selected_cpgs_", "").replace(".csv", "")

            with open(filepath) as f:
                for line in f:
                    line = line.rstrip("\n")
                    if not line.startswith("original_CpG"):
                        output_lines.append(f"{line},{chrom}")

        with open(output.statConcat, "w") as f:
            f.write("original_CpG,selected_CpG,cv_auc,best_c,best_l1_ratio,chrom\n")
            for out in output_lines:
                f.write(out + "\n")
        

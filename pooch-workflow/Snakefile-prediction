# Step 0: Data Check (FASTQ/BAM/Methylation bed)
########################################
rule step00_methylation_tag_check:
    output:
        check=f"{OUTDIR}/alignments/{SAMPLE}.step0_methylation_tag_check.done"
    log : 
        f"{OUTDIR}/alignments/{SAMPLE}.step0_methylation_tag_check.log"
    params:
        sample = SAMPLE,
        mainDir	= OUTDIR,
        fastqs = FASTQ_FILES,
        bam = BAM,
        metbed = MET_ON_PERSONALIZEDGENOME,
        met_hap1_ref = MET_HAP1_REFERENCE_BED,
        met_hap2_ref = MET_HAP2_REFERENCE_BED
    resources:
        mem_mb = lambda wildcards, attempt: attempt * 10000
    threads: THREADS
    shell:
        """
        exec > >(tee -a {log}) 2>&1
        mkdir -p {params.mainDir}/alignments

        if [ ! -z "{params.fastqs}" ]; then
            echo "Checking FASTQ headers for {params.sample}"
            bash {SCRIPTS_DIR}/00.check_fastq_header.sh "{params.fastqs}" {params.mainDir} {params.sample}

        elif [ ! -z "{params.bam}" ]; then
            echo "Checking BAM methylation tags for {params.sample}"
            bash {SCRIPTS_DIR}/00.check_bam_tags.sh {params.bam} {params.mainDir} {params.sample}

        elif [ ! -z "{params.metbed}" ]; then
            echo "Methylation bed file provided: {params.metbed}. Skipping methylation tag check."
            touch {output.check}
        
        elif [ -n "{params.met_hap1_ref}" ] && [ -n "{params.met_hap2_ref}" ]; then
            echo "Methylation bed lifted over to CHM13 are provided. Skipping methylation tag check."
            touch {output.check}
        else
            echo "No FASTQ, BAM, or methylation bed file provided. Cannot check methylation tags. Please provide at least one of these inputs."
            exit 1
        fi
        """

## if PERSONALIZEDGENOME_HAP1 and PERSONALIZEDGENOME_HAP2 are provided, Generate PERSONALIZEDGENOME_DIP from them, otherwise use the provided PERSONALIZEDGENOME_DIP

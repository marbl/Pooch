########################################
# Step 7: Classification of parental origin
########################################
# Check if chrY is present in the chromAssign.filtered.txt file

rule step07_check_XX_XY:
    input:
        chrom_assign_file = f"{OUTDIR}/chain/{REF_NAME}_to_{SAMPLE}.chromAssign.filtered.txt"
    output:
        chrom_list_out = f"{OUTDIR}/prediction/{SAMPLE}.chroms.txt",
        fofn_out = f"{FOFN_PATH}"
    params:
        sample=SAMPLE,
        mainDir=OUTDIR,
        REF_NAME=REF_NAME
    log:
        f"{OUTDIR}/prediction/{SAMPLE}.step07_check_XX_XY.log"
    resources:
        mem_mb = lambda wildcards, attempt: attempt * 10000
    threads: THREADS
    run:
        import os

        sample = params.sample
        outdir = params.mainDir
        ref = params.REF_NAME

        os.makedirs(os.path.join(outdir, "prediction"), exist_ok=True)

        chrom_assign_file = input.chrom_assign_file

        # chroms = ["chr22"]  # start list (avoid mutating global state)
        chroms = [f"chr{i}" for i in range(1, 23)] + ["chrX"]

        if os.path.exists(chrom_assign_file):
            with open(chrom_assign_file) as fh:
                # more efficient than read() for large files:
                # 4th column is greater than 10000000 and 1st column is chrY, then it's XY sample
                has_chrY = any(line.split()[0] == "chrY" and int(line.split()[3]) > 10_000_000 for line in fh)

            if has_chrY:
                print("chrY found in chromAssign.filtered.txt, XY sample detected.")
                # save "$sample\tMale" to sex file
                with open(f"{outdir}/prediction/{sample}.sex.txt", "w") as f:
                    f.write(f"{sample}\tMale\n")

            else:
                print("chrY not found in chromAssign.filtered.txt, XX sample detected.")
                # save "$sample\tFemale" to sex file
                with open(f"{outdir}/prediction/{sample}.sex.txt", "w") as f:
                    f.write(f"{sample}\tFemale\n")

        # Write chrom list to file (one per line)
        with open(output.chrom_list_out, "w") as f:
            for c in chroms:
                f.write(c + "\n")

        fofn = outdir + "/prediction/" + sample + ".fofn"
        if os.path.exists(fofn):
            print(f"FOFN file already exists: {fofn}, skipping creation.")
        else:
            with open(outdir + "/prediction/" + sample + ".fofn", "w") as f:
                f.write(f"{sample}\tHap1\t{outdir}/methylation/{sample}_hap1.meth.{ref}.bed\n")
                f.write(f"{sample}\tHap2\t{outdir}/methylation/{sample}_hap2.meth.{ref}.bed\n")
        

print(f"Chromosomes to process for parent-of-origin prediction: {chroms}")


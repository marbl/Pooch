# Step 1: Generate personalized diploid genome
########################################
rule step01_generate_personalized_genome:
    input:
        hap1=HAP1_FA_PATH,
        hap2=HAP2_FA_PATH,
        check=f"{OUTDIR}/alignments/{SAMPLE}.step0_methylation_tag_check.done"
    output:
        diploid=DEFAULT_PERSONALIZEDGENOME_DIP
    log:
        f"{OUTDIR}/chain/{SAMPLE}.generate_personalized_genome.log"
    params:
        sample=SAMPLE,
        mainDir=OUTDIR,
        hap1_name=HAP1_NAME,
        hap2_name=HAP2_NAME
    shell:
        """
        exec > >(tee -a {log}) 2>&1
        echo "Generating diploid personalized genome from {input.hap1} and {input.hap2}"
        mkdir -p {OUTDIR}/alignment
        cat {input.hap1} {input.hap2} > {output.diploid}
        """


# ########################################
# Step 2: Alignment & merge & sorting
########################################
rule step02_align:
    input:
        reference=PERSONALIZEDGENOME_DIP_PATH,
        check=f"{OUTDIR}/alignments/{SAMPLE}.step0_methylation_tag_check.done"
    output:
        bam=f"{OUTDIR}/alignments/{SAMPLE}.pri.bam"
    log:
        f"{OUTDIR}/alignments/{SAMPLE}.align.log"
    params:
        platform=PLATFORM,
        sample=SAMPLE,
        mainDir=OUTDIR,
        fastqs=FASTQ_FILES,
        threads=THREADS,
        mapper=MAPPER
    resources:
        mem_mb = lambda wildcards, attempt: attempt * THREADS * 1000
    threads: THREADS
    shell:
        """
        # exit if BAM is existed
        if [ -f "{output.bam}" ]; then
            echo "BAM file {output.bam} already exists. Skipping alignment step."
            echo -e "This might be because the BAM file was provided as input or the alignment step has already been completed."
            echo -e "But snakemake was trying to run the alignment step again. Please check your input parameters and output directory."
            echo -e "If you want to rerun the alignment step, please remove the existing BAM file and rerun snakemake."
            echo -e "If you don't want to rerun the alignment step, please provide the existing BAM file as input and rerun snakemake or touch the output BAM file to skip the alignment step."
            echo -e "\n"
            exit 0
        fi
        
        echo "Aligning {params.sample} reads to {input.reference} using {params.mapper}"
        if [ "{params.mapper}" = "Winnowmap2" ]; then
            TMPDIR={resources.tmpdir} bash {SCRIPTS_DIR}/01.align_winnowmap.sh {input.reference} {params.mainDir} {params.sample} {params.fastqs} {params.platform} {params.threads} 2>&1 | tee {log}
            exit ${{PIPESTATUS[0]}}
        elif [ "{params.mapper}" = "Minimap2" ]; then
            TMPDIR={resources.tmpdir} bash {SCRIPTS_DIR}/01.align_minimap2.sh {input.reference} {params.mainDir} {params.sample} {params.fastqs} {params.platform} {params.threads} 2>&1 | tee {log}
            exit ${{PIPESTATUS[0]}}
        else
            echo "Unsupported platform: {params.mapper}. Please specify Winnowmap2 or Minimap2." | tee {log}
            exit 1
        fi
        """


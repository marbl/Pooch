        {params.mainDir} \
        {params.model} \
        {params.sample} \
        {params.REF_NAME} \
        {wildcards.chroms} \
        {input.hap1_bed} \
        {input.hap2_bed} \
        {input.sex}
        """

rule step09_cleaning_output:
    input:
        prediction=expand(f"{OUTDIR}/prediction/{{chroms}}.predict.out", chroms=chroms)
    output:
        prediction_concat=f"{OUTDIR}/prediction/{SAMPLE}.predict.out"
    params:
        sample=SAMPLE,
        mainDir=OUTDIR,
        REF_NAME=REF_NAME
    log:
        f"{OUTDIR}/prediction/{SAMPLE}.step09_cleaning_output.log"
    resources:
        mem_mb = lambda wildcards, attempt: attempt * 10000
    threads: THREADS 
    run: 
        import os

        output_lines = []
        sample = params.sample
        outdir = params.mainDir
        ref = params.REF_NAME

        for filepath in input.prediction:
            
            filename = os.path.basename(filepath)
            chrom = filename.replace(".predict.out", "")

            with open(filepath) as f:
                for line in f:
                    line = line.rstrip("\n")
                    if not line.startswith("Sample"):
                        output_lines.append(f"{line}\t{chrom}")

        with open(output.prediction_concat, "w") as f:
            f.write("Sample\tLeftOpHapLabel\tRightOpHapLabel\tLeftHapPredictedOrigin\tRightHapPredictedOrigin\tPredictProb_Maternal-Paternal\tPredictProb_Paternal-Maternal\tPredictionCorrect\tChrom\n")
            for out in output_lines:
                f.write(out + "\n")
        
